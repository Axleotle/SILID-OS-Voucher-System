# Supabase (separate project from Silid OS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Security
SILID_OS_API_KEY_HASH=sha256-hash-of-the-api-key

# Email (stub by default; replace with real provider)
EMAIL_PROVIDER=stub
EMAIL_FROM=vouchers@silid.ph
# RESEND_API_KEY=re_...
# SENDGRID_API_KEY=SG....

# Cron secret (Vercel Cron)
CRON_SECRET=your-cron-secret

# Ledger webhook (Silid OS endpoint)
LEDGER_WEBHOOK_URL=https://silid-os.example.com/api/webhooks/voucher
LEDGER_WEBHOOK_SECRET=your-webhook-signing-secret

# Feature flags override (comma-separated, for local dev)
# FEATURE_FLAGS_OVERRIDE=api_v1_validate,api_v1_hold
